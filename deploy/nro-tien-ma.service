[Unit]
Description=NRO Tien Ma game server
Wants=network-online.target
After=network-online.target mysql.service mariadb.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=nro
Group=nro
WorkingDirectory=/opt/nro_tien_ma
Environment=JAVA_XMS=256m
Environment=JAVA_XMX=2g
EnvironmentFile=-/etc/default/nro-tien-ma
ExecStart=/bin/bash /opt/nro_tien_ma/run.sh
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=120
SuccessExitStatus=143
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
